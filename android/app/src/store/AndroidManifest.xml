<?xml version="1.0" encoding="utf-8"?>
<!--
  商店版（store flavor）manifest 覆盖层 —— P1-28 渠道合规。

  ## 作用
  manifest merger 会把本文件与 src/main/AndroidManifest.xml 合并，
  这里用 `tools:node="remove"` 剔除两项**审核高风险权限**：

  1. `REQUEST_INSTALL_PACKAGES`（应用外安装）
     Google Play 政策明确限制：除少数类别（应用商店、企业分发、杀毒等）
     外不予批准。我们的自更新不需要它——商店版由商店负责更新。

  2. `USE_FULL_SCREEN_INTENT`（全屏 Intent）
     Android 14 起只允许闹钟/来电类应用使用。我们的下载完成通知不是
     紧急事件，用它会被拒审。侧载版保留（用户期望下完直接装），
     但商店版一律改为普通通知。

  ## 为什么用 remove 而不是在主 manifest 用 placeholder
  `tools:node` 的值必须是字面量（merge/remove/replace），
  Gradle 的 manifestPlaceholders 替换不了它。用 flavor 级 manifest
  才是 manifest merger 的标准做法，且不会让主 manifest 出现条件分支。

  ## 副作用（已知，必须配套）
  去掉安装权限后，Kotlin 侧的安装 Intent 会抛 ActivityNotFoundException。
  见 MainActivity.kt 的 `openInstaller()`：它先检查 `canRequestPackageInstalls()`，
  不可用时降级为「打开浏览器下载页」，避免直接崩溃。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 剔除应用外安装权限：商店版由商店更新 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!-- 剔除全屏 Intent：非闹钟/来电类用途在 Android 14+ 会被拒审 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove" />

</manifest>
